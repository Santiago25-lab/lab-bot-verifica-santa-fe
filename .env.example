# Copia este archivo como .env.local (desarrollo) o pon estas variables en Vercel.
# Todo es opcional para probar en local: sin Supabase los datos viven en memoria.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app
# Número del bot en formato internacional sin "+" (ej. 573001234567). Activa el botón de WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Usuario del bot de Telegram sin "@" (ej. VerificaSantaFeBot). Activa el botón de Telegram.
NEXT_PUBLIC_TELEGRAM_BOT=
# Responsable del tratamiento de datos (Ley 1581). Aparece en /privacidad.
NEXT_PUBLIC_RESPONSABLE_NOMBRE=
NEXT_PUBLIC_RESPONSABLE_CORREO=
NEXT_PUBLIC_RESPONSABLE_CIUDAD=Bogotá D.C.

# --- Seguridad ---
# Contraseña del panel /admin
ADMIN_PASSWORD=
# Texto largo y aleatorio para crear los IDs anónimos (no lo cambies después de lanzar).
ANON_ID_SECRET=
# Opcional: otro texto aleatorio para firmar la sesión del panel.
ADMIN_SESSION_SECRET=

# --- Base de datos (Supabase → Project Settings → API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (habla con @BotFather → /newbot) ---
# Luego entra a /admin y toca "Conectar Telegram".
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Business Platform (Meta for Developers → tu app → WhatsApp → API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que inventas tú y pegas también en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Settings → Basic → App secret. Sirve para comprobar que los mensajes vienen de Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# --- IA de apoyo (Google AI Studio → Get API key) ---
GEMINI_API_KEY=
# Opcional. Si se deja vacío usa gemini-2.5-flash-lite y otros de respaldo si tarda o no existe.
GEMINI_MODEL=

# --- Reputación de links (Google Cloud → Safe Browsing API) ---
SAFE_BROWSING_API_KEY=
